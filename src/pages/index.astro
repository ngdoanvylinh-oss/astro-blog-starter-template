---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>👋 Xin chào, tôi là Nguyễn Doãn Vy Linh</h1>
			<p>
				Tôi là sinh viên chuyên ngành <strong>Phân tích dữ liệu kinh tế và chính sách</strong> tại Trường Đại học Kinh tế – ĐHQGHN.
			</p>
			<p>
				Trang web này là portfolio cá nhân của tôi, nơi tôi chia sẻ về quá trình học tập, kinh nghiệm và những mục tiêu phát triển nghề nghiệp, đặc biệt trong lĩnh vực dữ liệu và hệ thống.
			</p>
			<p>
				Bạn có thể tìm hiểu thêm chi tiết về trình độ học vấn, kỹ năng và kinh nghiệm của tôi tại trang <a href="/about">Giới thiệu</a>.
			</p>
			<h3>Thông tin liên hệ nhanh:</h3>
			<ul>
				<li>📞 Số điện thoại: 0964910229</li>
				<li>✉️ Email: ngdoanvylinh@gmail.com</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>